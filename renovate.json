{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "schedule:weekly"
  ],
  "timezone": "America/Chicago",
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Keep GitHub Actions current and merge safe updates without waiting.",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "Automerge non-breaking npm and tool updates.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true
    },
    {
      "description": "Major updates stay open for review.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Node engine floor follows the current LTS.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": true
    }
  ]
}
